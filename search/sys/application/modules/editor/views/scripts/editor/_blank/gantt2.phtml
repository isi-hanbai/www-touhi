            timeZone['startMinits'] = TstartMinits;

            var setupOffsetC = 0;
    				timeZone['setup'] = timeZone['setup']*1;


            //段取り時間が休憩時間にかかる場合開始時間を休憩時間の終了時間に設定
            if(timeZone['setup']*1 >0){
              var setupC = Math.ceil(timeZone['setup']/timePiece);
              loopA:
              for(var r = 0;r<setupC;r++){
                //比較するマスのエリアの秒数
                var setupStart = new Date(year,month-1,day,timeZone['start'],timeZone['startMinits']+r*timePiece);
                var setupStartS = setupStart.getHours()*3600+setupStart.getMinutes()*60;
                var setupBlockEnd = new Date(year,month-1,day,timeZone['start'],timeZone['startMinits']+timeZone['setup']);
                var setupBlockEndS = setupBlockEnd.getHours()*3600+setupBlockEnd.getMinutes()*60;
                //休憩時間中に段取り時間が何分入っているかを計測
                for(var s =0;s<Object.keys(json['rest']).length;s++){
                  //休憩時間の範囲を秒に変換
                  var restStart = new Date(year,month-1,day,json['rest'][s]['start'],json['rest'][s]['startMinits']);
                  var restStartS = restStart.getHours()*3600+restStart.getMinutes()*60;
                  var restEnd = new Date(year,month-1,day,json['rest'][s]['end'],json['rest'][s]['endMinits']);
                  var restEndS = restEnd.getHours()*3600+restEnd.getMinutes()*60;
                  //休憩時間が何マスになるかを計算
                  var rebc = (restEndS-restStartS)/60/timePiece;
                  for(var a =0;a<rebc;a++){
                    var rebS = restStartS+timePiece*a;
                    var rebE = restEndS+timePiece*a;
                    if((rebS >= setupStartS && rebS <= setupBlockEndS)
                    || (rebE >= setupStartS && rebE <= setupBlockEndS)
                    || (rebS >= setupStartS && rebE <= setupBlockEndS)
                    || (rebS <= setupStartS && rebE >= setupBlockEndS)){
                      data[j]['hasTimeZone'][l]['start'] = restEnd.getHours();
                      data[j]['hasTimeZone'][l]['startMinits'] = restEnd.getMinutes();
                      timeZone['start'] = restEnd.getHours();
                      timeZone['startMinits'] = restEnd.getMinutes();
                    }
                  }
                }
              }
            }
            //稼働時間に休憩が挟んだ場合は、終了時間に休憩時間の分数を加算
            var ccc = 0;
            var Rstart = new Array();
            var Rend = new Array();
            var rest = new Array();
            for(var i=0;i<Object.keys(json['rest']).length;i++){
              rest[i] = false;
              Rstart.push(new Date(year,month-1,day,json['rest'][i]['start'],json['rest'][i]['startMinits']));
              Rend.push(new Date(year,month-1,day,json['rest'][i]['end'],json['rest'][i]['endMinits']));
            }
            var totalLength = Math.ceil(timeZone['power']*timeZone['v'])*timeZone['quantity'];
            var c = Math.ceil(totalLength/timePiece);
            var ss = 0;
            var cc = 0;
            var ck2 =false;
            var restTotal = 0;
            for(var m=0;m<c;m++){
              //休憩時間を挟む場合は、休憩時間分空のマスを挿入
              var kadouSS = (timeZone['startMinits']*1+timeZone['setup']*1+(m+ccc)*timePiece);
              var kadou = new Date(year,month-1,day,timeZone['start'],kadouSS,0);
              var kadouS = kadou.getHours()*3600+kadou.getMinutes()*60;
              for(var k = 0;k<Rstart.length;k++){
                if(rest[k]==false){
                  var startS = Rstart[k].getHours()*3600+Rstart[k].getMinutes()*60;
                  var endS = Rend[k].getHours()*3600+Rend[k].getMinutes()*60;
                  if(startS<=kadouS && endS>kadouS){
                    rest[k] = true;
                    var restC = Math.floor((endS-startS)/60/timePiece);
                    ccc = ccc+restC;
                    restTotal = restTotal+((endS-startS)/60);
                    data[j]['hasTimeZone'][l]['rest'] = restTotal;
                  }
                }
              }
            }
            //終了時間を定義
            var end = new Date(startDate.getFullYear(),startDate.getMonth(),startDate.getDay(),timeZone['start'],timeZone['startMinits']+totalPower+restTotal,0);
            data[j]['hasTimeZone'][l]['end'] = end.getHours();
            data[j]['hasTimeZone'][l]['endMinits'] = end.getMinutes();
            timeZone['end'] = end.getHours();
            timeZone['endMinits'] = end.getMinutes();
            //終了時間が営業時間を超える場合は、翌営業日に繰越
            var endS = end.getHours()*60+end.getMinutes();
            var nowEnd = new Date(json['endDateTime'].replace("/-/","/"));
            var nowEndS = nowEnd.getHours()*60+nowEnd.getMinutes();
            //console.log(holyday);
            if(nowEndS < endS){
              for(var d = 1; d<=31; d++){
                var nextdate = new Date(startDate.getFullYear(),(startDate.getMonth()),(startDate.getDate()+d));
                var nextdateStr = nextdate.getFullYear()+"-"+zeroPadding(nextdate.getMonth()+1,2)+"-"+zeroPadding(nextdate.getDate(),2);
                if($.inArray(nextdateStr,holyday) == -1){
                  //console.log(data[j]['hasTimeZone'][l]);
                  var diffMinits = endS-nowEndS;
                  var next = new Date(nextdate.getFullYear(),nextdate.getMonth(),nextdate.getDate(),json['startH'],json['startI']+diffMinits);
                  break;
                }
              }
            }
            n = j;
            //作業ごとの開始時間と終了時間をDBに保存
            console.log(data[j]);
            var timezoneArr = {id:data[j]['hasTimeZone'][l]['id'],start:data[j]['hasTimeZone'][l]['start'],startMinits:data[j]['hasTimeZone'][l]['startMinits'],end:data[j]['hasTimeZone'][l]['end'],endMinits:data[j]['hasTimeZone'][l]['endMinits'],rest:data[j]['hasTimeZone'][l]['rest'],machine:data[j]["machineID"]};

            $.post("<?=BASEURL?>/api/sougi/inserttime",{data:JSON.stringify(timezoneArr)},function(data){
              foreach()
            });
          }
        }


        //この案件に使われる機械をすべて取得
        if(data[j]['machineID'] !=0){
          var ck=true;
          for(var k = 0;k<machine.length;k++){
            if(machine[k]['id'] == data[j]['machineID']){
              ck=false;
            }
          }
          if(ck==true){
            machine.push({id:data[j]['machineID'],name:data[j]['machineName']});
            machineID.push(data[j]['machineID']);
          }
        }
      }
      ganttchart();
      if(machineID.length !=0){
        var str="";
        var machineIDStr = machineID.join(",");
