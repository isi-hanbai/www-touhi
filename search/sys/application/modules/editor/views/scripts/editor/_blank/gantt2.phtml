              $(element).addClass("holyday");
						  $(".loading").css("display","none");
							//当月の稼働日数を取得
							var thisMonthHolyday = new Array();
							for(var j=0;j<holyday.length;j++){
								var hol = new Date(holyday[j].replace(/-/g,"/"));
								if(month == hol.getMonth()+1){
									thisMonthHolyday.push(holyday[j]);
								}
							}
							thisMonthMoveDays = thisMonthLastDay-thisMonthHolyday.length;
            }
