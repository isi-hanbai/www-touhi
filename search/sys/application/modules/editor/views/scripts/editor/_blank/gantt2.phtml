});

function ganttchart(){
  //console.log(data);
  //1時間あたりの分割数を定義
  if(json['timeSetting'] == 1){
    var timeMethod = 6;
  }else if(json['timeSetting'] == 2){
    var timeMethod = 4;
  }else if(json['timeSetting'] == 3){
    var timeMethod = 2;
  }else if(json['timeSetting'] == 4){
    var timeMethod = 0;
  }
  var timePiece = 60/timeMethod;
  //日付テーブル
  if(falseCheck(getArr()['year']) && falseCheck(getArr()['month']) && falseCheck(getArr()['day'])){
    hiduke=new Date(getArr()['year'],getArr()['month']-1,getArr()['day']);
  }else{
    hiduke=new Date(json['startDateTime'].split(" ")[0].replace(/-/g,"/"));
  }
  var year = hiduke.getFullYear();
  var month = hiduke.getMonth()+1;
  var week = hiduke.getDay();
  var day = hiduke.getDate();
  var yobi= new Array("日","月","火","水","木","金","土");
  $("#date").text(month+"/"+day+"("+yobi[week]+")");
  if(yobi[week] == "日"){
    $("#date").addClass("holyday");
  }
  //休憩時間をjs日付データに変換
  var Rstart = new Array();
  var Rend = new Array();
  for(var i=0;i<Object.keys(json['rest']).length;i++){
    Rstart.push(new Date(year,month-1,day,json['rest'][i]['start'],json['rest'][i]['startMinits']));
    Rend.push(new Date(year,month-1,day,json['rest'][i]['end'],json['rest'][i]['endMinits']));
  }
  //時分テーブル
  var hour = new Array();
  var mitnitsCnt = (json["end"]-json['start']+1)*timeMethod;
  if(mitnitsCnt == 0){
    mitnitsCnt = json["end"]-json['start']+1;
  }
  var str = "";
  str+= "<tr>";
  for(var i=(json['start']*1);i<=(json['end']*1);i++){
    str+= "<td";
    //幅、高さの調整
    if(timeMethod>0){
      str+= " colspan=\""+timeMethod+"\"";
    }else{
      str+= " style=\"height:30px;line-height:30px;font-size:14px;\"";
    }
    str+= ">"+i+"</td>";
    hour.push(i);
  }
  str+= "</tr>";
  if(timeMethod != 0){
    str+= "<tr>";
    for(var i=0;i<mitnitsCnt;i++){
      var time = timePiece*(i%timeMethod);
      var h = json['start']+Math.floor(i/timeMethod);
      str+= "<td style=\"text-align:left;\"";
      //休み時間の調整
      var now = new Date(year,month-1,day,h,time);
      var nowS = now.getHours()*3600+now.getMinutes()*60;
      for(var k = 0;k<Rstart.length;k++){
        var startS = Rstart[k].getHours()*3600+Rstart[k].getMinutes()*60;
        var endS = Rend[k].getHours()*3600+Rend[k].getMinutes()*60;
        if(startS<=nowS && endS>nowS){
          str+= " class=\"holyday\"";
        }
      }
      str+= ">";
      str+= time;
      str+= "</td>";
    }
    str+= "</tr>";
  }
  $("#hourTabel").html(str);
  // 工程項目テーブル
  var str3 = '';
  for(var j=0;j<Object.keys(data).length;j++){
    str3 += '<tr>';
    str3 += '<td>'+data[j]['id']+'</td>';
    str3 += '<td>'+data[j]['name']+'</td>';
    str3 += '<td>'+data[j]['totalQuantity']+data[j]['unit']+'</td>';
    str3 += '</tr>';
  }
  $("#item").html(str3);
  // 工程タイムラインテーブル
  var str2= '';
  var n = 0;
  for(var j=0;j<Object.keys(data).length;j++){
    var rest = new Array();
    for(var i=0;i<Object.keys(json['rest']).length;i++){
      rest[i] = false;
    }
    str2+= '<div class="tlRow clearfix">';
    for(var i=0;i<mitnitsCnt;i++){
      var time = timePiece*(i%timeMethod);
      var h = json['start']*1+Math.floor(i/timeMethod);
      str2+= '<div class="';
      //休み時間の調整
      var now = new Date(year,month-1,day,h,time);
      var nowS = now.getHours()*3600+now.getMinutes()*60;
      var ck =false;
      for(var k = 0;k<Rstart.length;k++){
        var startS = Rstart[k].getHours()*3600+Rstart[k].getMinutes()*60;
        var endS = Rend[k].getHours()*3600+Rend[k].getMinutes()*60;
        if(startS<=nowS && endS>nowS){
          str2+= "holyday";
          ck =true;
        }
      }
      if(ck ==false){
        str2+= "tl";
      }
      str2+= '" data-id="'+data[j]['id']+'" data-time="'+h+':'+time+'">';
      //console.log(data[j]['hasTimeZone']);
      for(var l = 0;l<Object.keys(data[j]['hasTimeZone']).length;l++){
        var timeZone = data[j]['hasTimeZone'][l];
        var ccc = 0;
        var date = hiduke.getFullYear()+"-"+zeroPadding(hiduke.getMonth()+1,2)+"-"+zeroPadding(hiduke.getDate(),2);
        if(timeZone['startDate'] == date){
          if(timeZone['start'] == h){
            //どこのマスに入るかを計算
            var nowStart = new Date(year,month-1,day,h,time);
            var nowStartS = nowStart.getHours()*3600+nowStart.getMinutes()*60;
            var nowEnd = new Date(year,month-1,day,h,time+timePiece);
            var nowEndS = nowEnd.getHours()*3600+nowEnd.getMinutes()*60;
            var timeZoneMitnits = new Date(year,month-1,day,h,timeZone['startMinits']);
            var timeZoneMitnitsS = timeZoneMitnits.getHours()*3600+timeZoneMitnits.getMinutes()*60;
            if(nowStartS <=timeZoneMitnitsS && nowEndS>timeZoneMitnitsS){
              var totalLength = Math.ceil(timeZone['power']*timeZone['v'])*timeZone['quantity'];
              str2+= '<div class="timeZone clearfix" data-id="'+timeZone['id']+'">';
              //段取り時間のを描画
              /*
              var setupC = Math.ceil(timeZone['setup']/timePiece);
              for(var m=0;m<setupC;m++){
                str2+= "<span class=\"setup\">0</span>";
              }
              */
              if(timeZone['setup'] >= timePiece){
                //１マス分に満たない場合は、切り捨て（描画しない）
                var setupC = Math.ceil(timeZone['setup']/timePiece);
                //console.log(setupC);
                for(var m=0;m<setupC;m++){
                  str2+= "<span class=\"setup\">0</span>";
                }
              }
              //稼働時間を描画
              var c = Math.ceil(totalLength/timePiece);
              var ss = 0;
              var cc = 0;
              var ck2 =false;
              for(var m=0;m<c;m++){
                //１マスずつに表示する個数の計算
                var s = (timeZone['quantity']/c)+ss;
                var ss = parseFloat("0."+(String(s)).split(".")[1]);
                var sss = Math.floor(s);
                if(m+1 == Math.ceil(c)){
                  if(cc+sss > timeZone['quantity']){
                    sss = timeZone['quantity']-cc;
                  }
                }
                cc = cc+sss;
                //休憩時間を挟む場合は、休憩時間分空のマスを挿入
                var kadouSS = (timeZone['startMinits']*1+timeZone['setup']*1+(m+ccc)*timePiece);
                var kadou = new Date(year,month-1,day,timeZone['start'],kadouSS,0);
                var kadouS = kadou.getHours()*3600+kadou.getMinutes()*60;
                for(var k = 0;k<Rstart.length;k++){
                  if(rest[k]==false){
                    var startS = Rstart[k].getHours()*3600+Rstart[k].getMinutes()*60;
                    var endS = Rend[k].getHours()*3600+Rend[k].getMinutes()*60;
                    if(startS<=kadouS && endS>kadouS){
                      rest[k] = true;
                      var restC = Math.floor((endS-startS)/60/timePiece);
                      ccc = ccc+restC;
                      for(var o=0;o<restC;o++){
                        str2+= '<span class="empty">0</span>';
                      }
                    }
                  }
                }
                str2+= '<span class="kadou">'+ sss +'</span>';
              }
              str2+= '<div class="popover2">';
              str2+= zeroPadding(timeZone['start'],2)+':'+zeroPadding(timeZone['startMinits'],2)+"〜"+zeroPadding(timeZone['end'],2)+':'+zeroPadding(timeZone['endMinits'],2)+" <span class='setupText'>段取:"+timeZone['setup']+"分</span> <span class='fuka'>加工:"+totalLength+"分</span>";
              str2+= '</div>';
              str2+= '</div>';
            }
          }
        }
      }
      str2+= '</div>';
    }
    str2+= '</div>';
  }
  $("#tlWrap").html(str2);
  $('#bottomRightArea').scroll(function(e) {
      $('#bottomLeftArea').scrollTop($(this).scrollTop()); // 左下のDIVのスクロール位置を更新
      $('#topRightArea').scrollLeft($(this).scrollLeft()); // 右上のDIVのスクロール位置を更新
  });
  var tw =$("#bottomLeftTable").width();
  $("#bottomLeftArea").css("width",tw);
  $("#topLeftArea").css("width",tw);
  $("#topLeftTable").css("width",tw);
  var tw2 = $("#topRightTable").width();
  $(".tlWrap").css("width",tw2);
  $(".tl").data("id",$(this).offsetLeft);
  //ドラッグされる要素
	$(".timeZone").draggable({
    axis:"x",
    snap:".tl",
    containment:"#tlWrap",
    revert: "invalid",
    opacity:0.8,
    scrollSpeed:100,
		start : function (event , ui){
      $("#bottomRightArea").css("overflow","hidden");
		} ,
		// ドラッグ終了時に呼ばれる
		stop : function (event , ui){
      $("#bottomRightArea").css("overflow","auto");
		}
  });
  //ドロップされる要素
  $(".tl").droppable({
    drop: function(event, ui) {
      for(var i=0;i<data.length;i++){
        if(data[i]['id'] == $(this).data("id")){
          for(var j=0;j<Object.keys(data[i]['hasTimeZone']).length;j++){
            if(data[i]['hasTimeZone'][j]['id'] == ui.draggable[0].getAttribute("data-id")){
              data[i]['hasTimeZone'][j]['start']=$(this).data("time").split(":")[0];
              data[i]['hasTimeZone'][j]['startMinits']=$(this).data("time").split(":")[1];


              var setupOffsetC = 0;
              var offset = 0;
              var timeZone = data[i]['hasTimeZone'][j];
              var startDate = new Date(timeZone['startDate'].replace(/-/g,"/"));
              var power = timeZone['power']*1;
              var v = timeZone['v']*1;
              var q = timeZone['quantity']*1;
              var setup = timeZone['setup']*1;
              var totalPower = Math.ceil(power*v)*q+setup;


              //稼働時間に休憩が挟んだ場合は、終了時間に休憩時間の分数を加算
              var ccc = 0;
              var Rstart = new Array();
              var Rend = new Array();
              var rest = new Array();
              for(var n=0;n<Object.keys(json['rest']).length;n++){
                rest[n] = false;
                Rstart.push(new Date(year,month-1,day,json['rest'][n]['start'],json['rest'][n]['startMinits']));
                Rend.push(new Date(year,month-1,day,json['rest'][n]['end'],json['rest'][n]['endMinits']));
              }
              var totalLength = Math.ceil(timeZone['power']*timeZone['v'])*timeZone['quantity'];
              var c = Math.ceil(totalLength/timePiece);
              var ss = 0;
              var cc = 0;
              var restTotal = 0;
              var ck2 =false;
              for(var m=0;m<c;m++){
                //休憩時間を挟む場合は、休憩時間分空のマスを挿入
                var kadouSS = (timeZone['startMinits']*1+timeZone['setup']*1+(m+ccc)*timePiece);
                var kadou = new Date(year,month-1,day,timeZone['start'],kadouSS,0);
                var kadouS = kadou.getHours()*3600+kadou.getMinutes()*60;
                for(var k = 0;k<Rstart.length;k++){
                  if(rest[k]==false){
                    var startS = Rstart[k].getHours()*3600+Rstart[k].getMinutes()*60;
                    var endS = Rend[k].getHours()*3600+Rend[k].getMinutes()*60;
                    if(startS<=kadouS && endS>kadouS){
                      rest[k] = true;
                      var restC = Math.floor((endS-startS)/60/timePiece);
                      ccc = ccc+restC;
                      restTotal = restTotal+((endS-startS)/60);
                      data[i]['hasTimeZone'][j]['rest'] = restTotal;
                    }
                  }
                }
              }
              //終了時間を定義
              var M = timeZone['startMinits']*1+totalPower*1+restTotal;
              //var M = timeZone['startMinits']*1+totalPower*1+offset*1;
              var end = new Date(startDate.getFullYear(),startDate.getMonth(),startDate.getDay(),timeZone['start'],M,0);
              data[i]['hasTimeZone'][j]['end'] = end.getHours();
              data[i]['hasTimeZone'][j]['endMinits'] = end.getMinutes();
              //作業ごとの開始時間と終了時間をDBに保存
              var timezoneArr = {id:data[i]['hasTimeZone'][j]['id'],start:data[i]['hasTimeZone'][j]['start'],startMinits:data[i]['hasTimeZone'][j]['startMinits'],end:data[i]['hasTimeZone'][j]['end'],endMinits:data[i]['hasTimeZone'][j]['endMinits'],rest:data[i]['hasTimeZone'][j]['rest']};
              $.post("<?=BASEURL?>/api/sougi/inserttime",{data:JSON.stringify(timezoneArr)},function(data){
                console.log(data);
              });


            }
          }
        }
      }
      ganttchart();
    }
  });
}

function getArr(){
  var vars = {};
  var param = location.search.substring(1).split('&');
  for(var i = 0; i < param.length; i++) {
      var keySearch = param[i].search(/=/);
      var key = '';
      if(keySearch != -1) key = param[i].slice(0, keySearch);
      var val = param[i].slice(param[i].indexOf('=', 0) + 1);
      if(key != '') vars[key] = decodeURI(val);
  }
  return vars;
}
function falseCheck(v){
  if(v == undefined || v == null || v == false || v == ""){
    return false;
  }else{
    return true;
  }
}
function zeroPadding(num,length){
    return ('0000000000' + num).slice(-length);
}
$(document).on("click",".popover2",function(){
  $(this).css("display","none");
});
</script>
