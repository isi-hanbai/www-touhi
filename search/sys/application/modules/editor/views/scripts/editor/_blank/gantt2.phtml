    var DayEnd = new Date(year,month-1,day,json['end'],json['endMinits']);
    var moveOfDay = (DayEnd.getHours()*60+DayEnd.getMinutes())-(DayStart.getHours()*60+DayStart.getMinutes())+(json['overtime']*60);
    for(var i=0;i<json['rest'].length;i++){
      var restTimeStart = new Date(year,month-1,day,json['rest'][i]['start'],json['rest'][i]['startMinits']);
      var restTimeEnd = new Date(year,month-1,day,json['rest'][i]['end'],json['rest'][i]['endMinits']);
      var restTimeStartMinits = (restTimeEnd.getHours()*60+restTimeEnd.getMinutes())-(restTimeStart.getHours()*60+restTimeStart.getMinutes());
      moveOfDay = moveOfDay-restTimeStartMinits;
    }


    $.get("<?=BASEURL?>/api/holyday/?year="+year+"&month="+month,function(data3){
      //休日を取得して、上部のカレンダー表示部に休日を適用
      holyday = JSON.parse(data3);
