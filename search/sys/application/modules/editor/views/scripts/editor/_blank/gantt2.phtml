      }
      //月の稼働時間（分）
      //var thisMonthMoveDaysOfMinits = moveOfDay*thisMonthMoveDays;//本当の数値
      var thisMonthMoveDaysOfMinits = 10;
      //読み込み時の設定
      var n = 0;
      for(var j=0;j<Object.keys(data).length;j++){
        for(var l = 0;l<Object.keys(data[j]['hasTimeZone']).length;l++){
          var timeZone = data[j]['hasTimeZone'][l];

          //console.log(data[j]['hasTimeZone'][l]['start'],data[j]['hasTimeZone'][l]['startMinits'],data[j]['hasTimeZone'][l]['end'],data[j]['hasTimeZone'][l]['endMinits']);


          if(timeZone['start'] == 0 && timeZone['end'] == 0){
            var startDate = new Date(timeZone['startDate'].replace(/-/g,"/"));
            var power = timeZone['power']*1;
            var v = timeZone['v']*1;
            var q = timeZone['quantity']*1;
            var setup = timeZone['setup']*1;
            var totalPower = Math.ceil(power*v)*q+setup;
            //console.log(json);
            if(j==0){
              //一番最初の工程
              var Tstart = json['startH'];
              var TstartMinits = json['startI'];
            }else{
              //２個め以降の工程(分単位)
              var Tstart = data[n]['hasTimeZone'][l]['end'];
              var TstartMinits = data[n]['hasTimeZone'][l]['endMinits'];
            }
