<style>
  :root {
    --primary: #2a7fff;
    --primary-dark: #1a52a5;
    --bg-soft: #f0f4f9;
    --border: #dfe6ee;
    --text: #333;
    --muted: #666;
    --card-bg: #fafafa;
  }

  * { box-sizing: border-box; }

  .hitokuchi-wrap {
    max-width: 920px;
    margin: 0 auto;
    padding: 24px 20px 40px;
    color: var(--text);
    font-family: sans-serif;
    line-height: 1.6;
  }

  .hitokuchi-wrap h2 {
    border-bottom: 2px solid var(--primary);
    padding-bottom: 8px;
    color: var(--primary-dark);
    margin: 0 0 20px;
    font-size: 1.9rem;
  }

  .hitokuchi-wrap h3 {
    margin-top: 30px;
    background: var(--bg-soft);
    padding: 10px 14px;
    border-left: 4px solid var(--primary);
    font-size: 1.2rem;
  }

  .memo-card {
    display: flex;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 18px;
    background: var(--card-bg);
    gap: 18px;
    align-items: center;
    margin-bottom: 20px;
  }

  .thumbnail {
    width: 130px;
    height: 160px;
    object-fit: cover;
    border: 1px solid #ccc;
    border-radius: 6px;
    box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.08);
    background: #fff;
    flex-shrink: 0;
  }

  .memo-info { flex: 1; min-width: 0; }

  .memo-date {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 10px;
  }

  .memo-title {
    font-weight: 700;
    font-size: 1.12rem;
    margin-bottom: 12px;
    word-break: break-word;
  }

  .download-btn {
    display: inline-block;
    background: var(--primary);
    color: #fff;
    padding: 10px 18px;
    text-decoration: none;
    border-radius: 5px;
    font-weight: 700;
    transition: 0.2s ease;
    box-shadow: 0 4px 10px rgba(42, 127, 255, 0.18);
  }

  .download-btn:hover { background: var(--primary-dark); }

  .archive-year {
    font-weight: 700;
    margin-top: 18px;
    margin-bottom: 8px;
    font-size: 1rem;
  }

  .archive-list {
    list-style: none;
    padding-left: 14px;
    margin: 0;
  }

  .archive-list li {
    margin-bottom: 8px;
    line-height: 1.5;
  }

  .archive-list a {
    color: var(--primary);
    text-decoration: none;
  }

  .archive-list a:hover { text-decoration: underline; }

  .empty {
    padding: 18px;
    background: #f8f8f8;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  @media (max-width: 640px) {
    .hitokuchi-wrap {
      padding: 20px 14px 30px;
    }

    .hitokuchi-wrap h2 {
      font-size: 1.5rem;
    }

    .memo-card {
      flex-direction: column;
      align-items: flex-start;
    }

    .thumbnail {
      width: 100%;
      max-width: 180px;
      height: auto;
    }
  }
</style>

<div class="hitokuchi-wrap">
  <div id="memo-app"></div>
</div>

<script>
  const BASE_URL = '<?=BASEURL?>';
  const CATEGORY_ID = <?= !empty($this->hitokuchiMemoCategoryId) ? (int)$this->hitokuchiMemoCategoryId : 'null' ?>;

  function zeroPad(n) {
    return String(n).padStart(2, '0');
  }

  function formatDate(dateStr) {
    if (!dateStr) return '';
    const d = new Date(dateStr.replace(/-/g, '/'));
    if (isNaN(d.getTime())) return dateStr;
    return d.getFullYear() + '年' + zeroPad(d.getMonth() + 1) + '月' + zeroPad(d.getDate()) + '日';
  }

  function makeAbsoluteUrl(url) {
    if (!url) return BASE_URL + '/image/noImage.png';
    return /^https?:\/\//i.test(url) ? url : BASE_URL + url;
  }

  function getThumbUrl(row) {
    const thumb = row.thumb || row.thumb2 || row.image || '';
    return makeAbsoluteUrl(thumb);
  }

  function getPdfUrl(row) {
    const url =
      row.pdfUrl ||
      row.pdf_url ||
      row.file_url ||
      row.fileUrl ||
      row.download_url ||
      row.url ||
      row.link ||
      `${BASE_URL}/content/detail?id=${row.id}`;

    return /^https?:\/\//i.test(url) ? url : BASE_URL + url;
  }

  function groupByMonth(rows) {
    const map = new Map();

    rows.forEach(row => {
      const created = row.created || '';
      const d = new Date(created.replace(/-/g, '/'));
      if (isNaN(d.getTime())) return;

      const key = d.getFullYear() + '年' + zeroPad(d.getMonth() + 1) + '月';
      if (!map.has(key)) map.set(key, []);
      map.get(key).push(row);
    });

    return [...map.entries()].sort((a, b) => {
      const aa = a[0].match(/(\d+)年(\d+)月/);
      const bb = b[0].match(/(\d+)年(\d+)月/);
      if (!aa || !bb) return 0;
      const aNum = Number(aa[1]) * 100 + Number(aa[2]);
      const bNum = Number(bb[1]) * 100 + Number(bb[2]);
      return bNum - aNum;
    });
  }

  async function loadMemos() {
    const app = document.getElementById('memo-app');

    if (!CATEGORY_ID) {
      app.innerHTML = `
        <h2>健康一口メモ</h2>
        <div class="empty">現在、健康一口メモの掲載カテゴリが設定されていません。</div>
      `;
      return;
    }

    try {
      const res = await fetch(`${BASE_URL}/api/content?category=${CATEGORY_ID}&limit=50&p=0`, {
        method: 'GET',
        mode: 'cors'
      });

      if (!res.ok) {
        throw new Error('API request failed');
      }

      const rows = await res.json();
      const list = (Array.isArray(rows) ? rows : [])
        .filter(row => row && row.name)
        .sort((a, b) => new Date(b.created || 0) - new Date(a.created || 0));

      if (!list.length) {
        app.innerHTML = `
          <h2>健康一口メモ</h2>
          <div class="empty">掲載中の記事はありません。</div>
        `;
        return;
      }

      const latest = list[0];
      const archiveRows = list.slice(1);
      const archiveHtml = groupByMonth(archiveRows)
        .map(([monthKey, items]) => {
          const liHtml = items.map(item => {
            const label = item.name || '健康一口メモ';
            const dateText = formatDate(item.created);
            const href = getPdfUrl(item);
            return `<li>📄 <a href="${href}" target="_blank" rel="noopener">${label}（${dateText}）</a></li>`;
          }).join('');

          return `
            <div class="archive-year">📅 ${monthKey}</div>
            <ul class="archive-list">${liHtml}</ul>
          `;
        })
        .join('');

      app.innerHTML = `
        <h2>健康一口メモ</h2>

        <h3>最新の掲載</h3>
        <div class="memo-card">
          <img src="${getThumbUrl(latest)}" alt="${(latest.name || '健康一口メモ').replace(/"/g, '&quot;')}" class="thumbnail">
          <div class="memo-info">
            <div class="memo-date">健康一口メモ ${formatDate(latest.created)} 掲載分</div>
            <div class="memo-title">${latest.name}</div>
            <a href="${getPdfUrl(latest)}" class="download-btn" target="_blank" rel="noopener">本文を読む / PDFを見る</a>
          </div>
        </div>

        <h3>過去の記事一覧</h3>
        ${archiveHtml || '<div class="empty">過去の記事はまだありません。</div>'}
      `;
    } catch (err) {
      console.error(err);
      app.innerHTML = `
        <h2>健康一口メモ</h2>
        <div class="empty">データの取得に失敗しました。</div>
      `;
    }
  }

  loadMemos();
</script>
