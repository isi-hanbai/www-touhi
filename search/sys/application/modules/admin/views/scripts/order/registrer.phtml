//商品一覧を取得して値を挿入
function itemAppend(json){
	var via = 1/100*taxRatio;
	$("#itemlist").empty();
	var n =json.length *115;
	$("#itemlist").css("width",n+"px");
	for(var i =0;i<json.length;i++){
		//商品ごとの枠
		var div = $('<div class="pull-left">');
		div.css("margin-right","10px");
		$("#itemlist").append(div);
		//画像（サムネイル）
		var img = $('<a class="thumb">');
		if(json[i]["imagen"] == null){
			img.css("background-image","url(<?=BASEURL."/"?>/img/noimage.jpg)");
		}else{
			img.css("background-image","url(<?=BASEURL."/"?>"+json[i]["imagen"]+")");
			img.attr("href","<?=BASEURL."/"?>"+json[i]["imagen"]);
			img.attr("rel","lightbox");
			img.addClass("bigger");
		}
		div.append($('<p style="line-height:1em">').append(img));
		//価格
		var price = json[i]['price'];
		div.append($('<p style="text-align:center;line-height:1em;font-weight:bold">').text(price+"円"));
		//ボタン
		var btn2 = $("<button>");
		btn2.type = "button";
		btn2.addClass("btn btn-success lib");
		btn2.text(json[i]["number"]);
		btn2.attr("id",json[i]["number"]);
		div.append($('<p style="text-align:center;line-height:1em">').append(btn2));
		var id = json[i]["number"];
	}
}
function addCart(number){
	var exists = false;
	for(var i=0;i<cart.length;i++){
		if(cart[i]['data']['number'] == number){
			cart[i]['q'] = cart[i]['q']*1 +1;
			exists = true;
			parseCart();
			break;
		}
	}
	if(!exists){
		$.post(
			"<?=BASEURL?>/api/item/itemofnumber",
			{
				"merchant":<?=$this->user->id?>,
				"number":number
			},
			function(data2){
				var itemD = JSON.parse(data2);
				addData = {'q':1,'data':itemD}
				cart.push(addData);
				//表示用のスクリプトを記載
				parseCart();
			}
		);
	}
	return false;
}
function delCart(number){
	for(var i =0;i<cart.length;i++){
		if(cart[i]['data']['number'] ==number){
			cart[i]['q'] = cart[i]['q']-1;
			if(cart[i]['q'] ==　0){
				//数量が０になった場合は、データ自体を削除
				cart.splice(i,1) ;
			}
			break;
		}
	}
	//表示用のスクリプトを記載
	parseCart();
	return false;
}
