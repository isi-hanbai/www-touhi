	$("[name='cus_birthY']").on("mousedown",function(){
		if(sely == 0){
			var hiduke=new Date();
			var year = hiduke.getFullYear();
			var month = hiduke.getMonth()+1;
			//今日の年を取得
			year = year-35;
			$(this).val(year);
		}
	});
	$("[name='cus_birthY']").on("change",function(){
		$("[name='cus_birthM']").empty();
		$("[name='cus_birthM']").append($("<option>").val("").text("月を選択"));
		for(var i =0; i<12; i++){
			$("[name='cus_birthM']").append($("<option>").val((i+1)).text((i+1)));
		}
		getLastDayOfMonth(1);
		sely = $("[name='cus_birthY']").val();
		$("[name='cus_birthD']").empty();
		$("[name='cus_birthD']").append($("<option>").val("").text("日を選択"));
	});
	$("[name='cus_birthM']").on("change",function(){
		getLastDayOfMonth();
	});
});
